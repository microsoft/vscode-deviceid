{
  "name": "@vscode/deviceid",
  "version": "0.1.6",
  "description": "A module for Visual Studio Code to generate a unique device ID",
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "test": "npm run compile && node --test",
    "test:package": "node scripts/verify-package.mjs",
    "build": "npm run compile",
    "compile": "tsc",
    "install": "node scripts/install.mjs",
    "prebuild:windows": "prebuildify --napi --target 20.19.0",
    "prepack": "npm run compile && node scripts/check-prebuilds.mjs",
    "lint": "eslint . --ext .js,.mjs,.ts --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-deviceid"
  },
  "author": "Microsoft Corporation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Microsoft/vscode-deviceid/issues"
  },
  "homepage": "https://github.com/Microsoft/vscode-deviceid/#readme",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.71.1-alpha.14",
    "@typescript-eslint/parser": "^8.71.1-alpha.14",
    "eslint": "^8.57.0",
    "node-gyp": "^12.4.0",
    "prebuildify": "^6.0.1",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "node-gyp-build": "^4.8.4",
    "uuid": "^14.0.0"
  }
}
