{
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmitOnError": false,
		"strict": true,
		"target": "ES2020",
		"module": "NodeNext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"inlineSources": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "NodeNext",
		"declaration": true
	}
}
